---
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import BaseLayout from '../layouts/BaseLayout.astro'
import CanonPageShell from '../components/CanonPageShell'
import { libraryClientMeta } from '../data/library'
import { canonActs, canonWorks } from '../data/canon'

const siteUrl = 'https://french.milovicake.ru'
const canonicalUrl = `${siteUrl}/canon/`

const libraryIds = new Set(libraryClientMeta.map((article) => article.id))
const canonIds = canonWorks.map((work) => work.id)
const duplicateCanonIds = canonIds.filter((id, index) => canonIds.indexOf(id) !== index)
const articleIds = canonWorks.flatMap((work) => work.articleId ? [work.articleId] : [])
const duplicateArticleIds = articleIds.filter((id, index) => articleIds.indexOf(id) !== index)
const brokenArticleLinks = canonWorks
  .filter((work) => work.articleId && !libraryIds.has(work.articleId))
  .map((work) => `${work.id} -> ${work.articleId}`)
const malformedActs = canonActs
  .map((act) => ({ act: act.id, count: canonWorks.filter((work) => work.act === act.id).length }))
  .filter(({ count }) => count !== 5)
const badOrder = canonWorks
  .map((work, index) => ({ id: work.id, expected: index + 1, actual: work.order }))
  .filter(({ expected, actual }) => expected !== actual)
const imagesWithoutAlt = canonWorks.filter((work) => work.image && !work.imageAlt).map((work) => work.id)
const mediaPaths = canonWorks.flatMap((work) => [work.image, work.imageMobile].filter((value): value is string => Boolean(value)))
const missingMedia = mediaPaths.filter((src) => !existsSync(join(process.cwd(), 'public', src.replace(/^\//, ''))))

const gridErrors: string[] = []
for (const act of canonActs) {
  for (const row of [1, 2] as const) {
    const cells = Array<string | null>(12).fill(null)
    for (const work of canonWorks.filter((item) => item.act === act.id && item.gridRow === row)) {
      const first = work.gridStart - 1
      const last = first + work.gridSpan
      if (first < 0 || last > 12) {
        gridErrors.push(`${act.id}/row${row}/${work.id}: grid ${work.gridStart}+${work.gridSpan} exceeds 12 columns`)
        continue
      }
      for (let column = first; column < last; column += 1) {
        if (cells[column]) {
          gridErrors.push(`${act.id}/row${row}: ${work.id} overlaps ${cells[column]} at column ${column + 1}`)
        } else {
          cells[column] = work.id
        }
      }
    }
    const emptyColumns = cells.flatMap((value, index) => value ? [] : [index + 1])
    if (emptyColumns.length > 0) {
      gridErrors.push(`${act.id}/row${row}: empty columns ${emptyColumns.join(',')}`)
    }
  }
}

if (canonWorks.length !== 15) {
  throw new Error(`[canon] Expected exactly 15 works, received ${canonWorks.length}`)
}
if (duplicateCanonIds.length > 0) {
  throw new Error(`[canon] Duplicate work ids: ${[...new Set(duplicateCanonIds)].join(', ')}`)
}
if (duplicateArticleIds.length > 0) {
  throw new Error(`[canon] One article cannot represent multiple Canon works: ${[...new Set(duplicateArticleIds)].join(', ')}`)
}
if (brokenArticleLinks.length > 0) {
  throw new Error(`[canon] Unknown article links: ${brokenArticleLinks.join(', ')}`)
}
if (malformedActs.length > 0) {
  throw new Error(`[canon] Every act must contain exactly five works: ${malformedActs.map(({ act, count }) => `${act}=${count}`).join(', ')}`)
}
if (badOrder.length > 0) {
  throw new Error(`[canon] Order must be contiguous 1–15: ${badOrder.map(({ id, expected, actual }) => `${id}:${actual}!=${expected}`).join(', ')}`)
}
if (gridErrors.length > 0) {
  throw new Error(`[canon] Editorial grid must fill two 12-column rows per act without overlap: ${gridErrors.join(' | ')}`)
}
if (imagesWithoutAlt.length > 0) {
  throw new Error(`[canon] Public work images require imageAlt: ${imagesWithoutAlt.join(', ')}`)
}
if (missingMedia.length > 0) {
  throw new Error(`[canon] Missing public media: ${missingMedia.join(', ')}`)
}

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${canonicalUrl}#collection`,
  name: 'Le Canon Sucré',
  description: 'Кураторская коллекция из 15 форм французской pâtisserie.',
  numberOfItems: canonWorks.length,
  itemListElement: canonWorks.map((work) => ({
    '@type': 'ListItem',
    position: work.order,
    name: work.name,
    ...(work.articleId ? { url: `${siteUrl}/articles/${work.articleId}/` } : {}),
  })),
}

const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': canonicalUrl,
  url: canonicalUrl,
  name: 'Le Canon Sucré — Pâtisserie Russe',
  description: '15 десертов. Три акта. Кураторский маршрут по формам, техникам и переосмыслениям французской pâtisserie.',
  inLanguage: 'ru',
  mainEntity: { '@id': `${canonicalUrl}#collection` },
}

const safeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c')
---

<BaseLayout
  title="Le Canon Sucré — Pâtisserie Russe"
  description="15 десертов. Три акта. Кураторский маршрут по формам, техникам и переосмыслениям французской pâtisserie."
  canonicalUrl={canonicalUrl}
  ogType="website"
  image="/images/og-preview.webp"
  ogImageWidth={1200}
  ogImageHeight={630}
  hidePolicyFooter={true}
>
  <script is:inline type="application/ld+json" set:html={safeJsonLd(collectionPage)} slot="head" />
  <script is:inline type="application/ld+json" set:html={safeJsonLd(itemList)} slot="head" />
  <CanonPageShell articles={libraryClientMeta} client:load />
</BaseLayout>
