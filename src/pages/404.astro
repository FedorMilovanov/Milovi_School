---
import BaseLayout from '../layouts/BaseLayout.astro'

Astro.response.status = 404
---

<BaseLayout
  title="Страница не найдена — Patisserie Russe"
  description="Эта страница не существует или была перемещена."
  robots="noindex, follow"
  noCanonical
>
  <main id="main-content" class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-amber-700 dark:text-amber-400">404</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold tracking-[-0.04em] text-stone-950 dark:text-stone-100 sm:text-5xl">
      Страница не найдена
    </h1>
    <p class="mt-4 max-w-md text-base leading-7 text-stone-500 dark:text-stone-400">
      Возможно, адрес изменился или страница была удалена.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 border border-stone-950 px-6 py-3 font-mono text-[11px] uppercase tracking-[0.2em] text-stone-950 transition hover:bg-stone-950 hover:text-amber-100 dark:border-amber-100 dark:text-amber-100 dark:hover:bg-amber-100 dark:hover:text-stone-950"
    >
      ← На главную
    </a>
    {/*
      A 404 is a landing page for stale external links and old sitemaps, so it
      must not be a dead end: give the three real hubs that lead to every one of
      the 158 materials. Server-rendered anchors only — no JS to recover from.
    */}
    <nav aria-label="Куда перейти" class="mt-10 w-full max-w-xl">
      <p class="font-mono text-[10px] uppercase tracking-[0.28em] text-stone-400 dark:text-stone-500">Куда перейти</p>
      <ul class="mt-4 grid gap-px border border-[var(--border)] bg-[var(--border)] sm:grid-cols-3">
        <li class="bg-[var(--bg-main)]">
          <a href="/materials/" class="flex h-full flex-col gap-1 px-5 py-4 transition hover:bg-[var(--bg-deep)]">
            <span class="font-serif text-lg text-stone-900 dark:text-stone-100">Галерея</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-stone-500 dark:text-stone-400">все материалы</span>
          </a>
        </li>
        <li class="bg-[var(--bg-main)]">
          <a href="/history/" class="flex h-full flex-col gap-1 px-5 py-4 transition hover:bg-[var(--bg-deep)]">
            <span class="font-serif text-lg text-stone-900 dark:text-stone-100">История</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-stone-500 dark:text-stone-400">19 материалов</span>
          </a>
        </li>
        <li class="bg-[var(--bg-main)]">
          <a href="/canon/" class="flex h-full flex-col gap-1 px-5 py-4 transition hover:bg-[var(--bg-deep)]">
            <span class="font-serif text-lg text-stone-900 dark:text-stone-100">Le Canon</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-stone-500 dark:text-stone-400">15 форм</span>
          </a>
        </li>
      </ul>
    </nav>
  </main>
</BaseLayout>
