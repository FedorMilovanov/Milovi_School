---
import BaseLayout from '../layouts/BaseLayout.astro'
import GalleryApp from '../components/gallery/GalleryApp'
import { libraryClientMeta } from '../data/library'

const siteUrl = 'https://french.milovicake.ru'
const safeJson = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c')

const jsonLdCollection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Галерея материалов — Patisserie Russe',
  description: 'Визуальная галерея всех материалов о французской кондитерской школе: статьи, рецепты и переводы с фотографиями.',
  url: `${siteUrl}/materials/`,
  inLanguage: 'ru',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Patisserie Russe',
    url: `${siteUrl}/`,
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: libraryClientMeta.length,
    itemListElement: libraryClientMeta.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/articles/${article.id}/`,
      name: article.title,
    })),
  },
}

const jsonLdBreadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Галерея материалов',
      item: `${siteUrl}/materials/`,
    },
  ],
}
---

<BaseLayout
  title="Галерея материалов — Patisserie Russe"
  description="Визуальная галерея всех материалов о французской кондитерской школе: статьи, рецепты и переводы с фотографиями."
  canonicalUrl="https://french.milovicake.ru/materials/"
  image="/images/og-preview.webp"
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <script is:inline type="application/ld+json" set:html={safeJson(jsonLdCollection)} slot="head" />
  <script is:inline type="application/ld+json" set:html={safeJson(jsonLdBreadcrumbs)} slot="head" />

  <!--
    Render the complete gallery on the server, then hydrate the same React tree
    through a normal bundled module. The client receives only the compact card
    metadata embedded below, never the full article-content module.
  -->
  <div id="gallery-app-root">
    <GalleryApp articles={libraryClientMeta} />
  </div>
  <script id="gallery-app-data" type="application/json" set:html={safeJson(libraryClientMeta)} />

  <script>
    import { createElement } from 'react'
    import { hydrateRoot } from 'react-dom/client'
    import GalleryApp from '../components/gallery/GalleryApp'

    const root = document.getElementById('gallery-app-root')
    const data = document.getElementById('gallery-app-data')?.textContent

    if (root && data) {
      const articles = JSON.parse(data)
      hydrateRoot(root, createElement(GalleryApp, { articles }))
    }
  </script>
</BaseLayout>
