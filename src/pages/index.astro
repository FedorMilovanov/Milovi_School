---
/**
 * Home page — /
 *
 * Renders HomeApp as a React client island.
 * Passes only article METADATA (no content) to the browser.
 * deepContents.ts is used only at build time and never shipped.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import HomeApp from '../components/HomeApp'
import { libraryClientMeta } from '../data/library'

const siteUrl = 'https://french.milovicake.ru'

const jsonLdOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Patisserie Russe / Milovi School',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/images/logo.png`,
  },
  description:
    'Библиотека материалов о французской кондитерской школе. Гроле, Эрме, Мишалак, Метайе, Куврер — техники, разборы, рецепты.',
  inLanguage: 'ru',
  parentOrganization: {
    '@type': 'Organization',
    name: 'Milovi Cake',
    url: 'https://milovicake.ru',
  },
  sameAs: ['https://milovicake.ru'],
}

const jsonLdWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'Patisserie Russe',
  url: siteUrl,
  inLanguage: 'ru',
  publisher: { '@id': `${siteUrl}/#organization` },
}

const safeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c')
---

<BaseLayout
  title="Patisserie Russe — Французская кондитерская школа"
  description="Библиотека материалов о французской кондитерской школе. Гроле, Эрме, Мишалак, Метайе, Куврер — техники, разборы, рецепты."
  canonicalUrl="https://french.milovicake.ru/"
  ogType="website"
  image="/images/og-preview.webp"
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <script is:inline type="application/ld+json" set:html={safeJsonLd(jsonLdOrg)} slot="head" />
  <script is:inline type="application/ld+json" set:html={safeJsonLd(jsonLdWebSite)} slot="head" />

  <HomeApp articles={libraryClientMeta} client:load />
</BaseLayout>
