---
/**
 * Home page — /
 *
 * Renders HomeApp as a React client island.
 * Passes only article METADATA (no content) to the browser.
 * deepContents.ts is used only at build time and never shipped.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import HomeApp from '../components/HomeApp'
import { libraryClientMeta } from '../data/library'
import { entityGraph, ENTITY_IDS, schoolNode } from '../data/entityGraph'

const siteUrl = 'https://french.milovicake.ru'

// Home uses the canonical @graph (Person / Bakery / Organization / School) so
// Google and LLM retrievers join the founder and both projects into one graph.
const homeGraph = entityGraph() as {
  '@context': string
  '@graph': Record<string, unknown>[]
}
homeGraph['@graph'].push({
  '@type': 'WebSite',
  '@id': ENTITY_IDS.website,
  name: 'Patisserie Russe',
  alternateName: ['Milovi School', 'Patisserie Russe by Milovi School'],
  url: siteUrl,
  inLanguage: 'ru',
  publisher: { '@id': ENTITY_IDS.school },
  disambiguatingDescription: schoolNode.disambiguatingDescription,
})

const safeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c')
---

<BaseLayout
  title="Patisserie Russe — Французская кондитерская школа"
  description="Библиотека материалов о французской кондитерской школе. Гроле, Эрме, Мишалак, Метайе, Куврер — техники, разборы, рецепты."
  canonicalUrl="https://french.milovicake.ru/"
  ogType="website"
  image="/images/og-preview.webp"
  imageAlt="Patisserie Russe — библиотека французской кондитерской школы"
  ogImageWidth={1200}
  ogImageHeight={630}
  hidePolicyFooter={true}
>
  <script is:inline type="application/ld+json" set:html={safeJsonLd(homeGraph)} slot="head" />

  <HomeApp articles={libraryClientMeta} client:load />
</BaseLayout>
