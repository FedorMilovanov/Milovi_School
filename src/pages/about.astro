---
import BaseLayout from '../layouts/BaseLayout.astro'
import StaticPageShell from '../components/StaticPageShell'
import { entityGraph, ENTITY_IDS, schoolNode } from '../data/entityGraph'

const siteUrl = 'https://french.milovicake.ru'
const canonicalUrl = `${siteUrl}/about/`

// /about/ describes the project, so it carries the full canonical entity graph
// plus an AboutPage node that points at the School and its founder.
const aboutGraph = entityGraph() as {
  '@context': string
  '@graph': Record<string, unknown>[]
}
aboutGraph['@graph'].push({
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#webpage`,
  name: 'О проекте Patisserie Russe / Milovi School',
  url: canonicalUrl,
  inLanguage: 'ru',
  isPartOf: { '@id': ENTITY_IDS.website },
  about: { '@id': ENTITY_IDS.school },
  mainEntity: { '@id': ENTITY_IDS.school },
  creator: { '@id': ENTITY_IDS.creator },
  editor: { '@id': ENTITY_IDS.creator },
  disambiguatingDescription: schoolNode.disambiguatingDescription,
})

const safeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c')
---

<BaseLayout
  title="О проекте — Patisserie Russe / Milovi School"
  description="Patisserie Russe — независимый образовательный проект Фёдора Милованова о французской pâtisserie: техники, история, рецепты и источники."
  canonicalUrl={canonicalUrl}
  ogType="website"
  image="/images/og-preview.webp"
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <script is:inline type="application/ld+json" set:html={safeJsonLd(aboutGraph)} slot="head" />

  <StaticPageShell client:load>
    <div class="px-4 py-12 sm:px-6 lg:px-8">
    <article class="mx-auto max-w-4xl">
      <a href="/" class="font-mono text-[11px] uppercase tracking-[0.24em] text-amber-800 underline decoration-amber-300 underline-offset-4 dark:text-amber-300">← На главную</a>

      <header class="mt-10 border-y border-[var(--border-subtle)] py-10">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-amber-800 dark:text-amber-300">Milovi School / Библиотека</p>
        <h1 class="mt-4 font-serif text-5xl font-semibold leading-tight tracking-[-0.06em] sm:text-6xl">О проекте</h1>
        <p class="mt-6 text-xl leading-8 text-stone-600 dark:text-stone-400">Patisserie Russe — независимая образовательная библиотека о французской кондитерской школе. Проект создан Фёдором Миловановым с применением генеративных нейросетей и сделан как открытый справочник для читателей, которым интересны техники, история, рецепты и язык французской pâtisserie.</p>
      </header>

      <section class="prose prose-stone mt-12 max-w-none dark:prose-invert prose-headings:font-serif prose-headings:tracking-[-0.04em] prose-a:text-amber-800 dark:prose-a:text-amber-300">
        <h2>Что важно понимать</h2>
        <p>Библиотека — независимый образовательный проект, созданный с применением генеративных нейросетей. Материалы не являются меню или технологическими картами производства кондитерской Milovi Cake и не описывают то, что она готовит на заказ. Мы изучаем французские источники, систематизируем профессиональные термины, объясняем технику на русском языке и даём ссылки на первоисточники.</p>

        <h2>Отдельная кондитерская Milovi Cake</h2>
        <p>Кондитерская <a href="https://milovicake.ru" target="_blank" rel="noopener noreferrer">milovicake.ru</a> в Санкт-Петербурге — отдельный проект, поддерживающий библиотеку. Она не является автором, редактором или рецензентом учебных разборов французских рецептур. Если читателю интересны готовые авторские торты и десерты, он может перейти на сайт кондитерской; рецепты и разборы Patisserie Russe не нужно воспринимать как ассортимент или коммерческое обещание Milovi Cake.</p>

        <h2>Редакционный принцип</h2>
        <p>Мы не копируем чужие статьи как есть. Материалы пишутся как учебные конспекты, смысловые переводы, сравнительные сводки и технологические разборы по нескольким источникам. Когда материал опирается на конкретную публикацию, школу, дом или шефа, ссылка указывается на странице статьи.</p>

        <h2>Какие источники считаем приоритетными</h2>
        <ul>
          <li>официальные страницы шефов, школ, домов pâtisserie и ресторанов;</li>
          <li>французские и международные отраслевые издания: Gault&amp;Millau, Michelin Guide, So Good Magazine, Fou de Pâtisserie, Le Figaro, Le Monde;</li>
          <li>образовательные институции и профессиональные программы: FERRANDI Paris, École Ducasse, INBP, Institut Lyfe / Paul Bocuse;</li>
          <li>исторические архивы и библиотеки: BnF / Gallica, старые французские кулинарные трактаты, каталоги и справочники;</li>
          <li>официальные данные рынка и профессии: CNBPF, INSEE, RNCP / France Compétences.</li>
        </ul>

        <h2>Как читать рецепты</h2>
        <p>Рецепты в библиотеке — образовательные. Они помогают понять структуру десерта, температуру, текстуру и последовательность работы. Домашние условия, мука, влажность, духовка, шоколад и молочные продукты сильно влияют на результат, поэтому мы постепенно добавляем блоки диагностики ошибок, замены ингредиентов и профессиональные примечания.</p>

        <h2>Кто создал проект</h2>
        <p><strong>Фёдор Милованов</strong> — создатель, редактор и дизайнер Patisserie Russe. Он задумал и собрал библиотеку как независимый образовательный проект, применив генеративные нейросети для дизайна, редактуры и технической реализации: от подбора и проверки источников до вёрстки и иллюстраций.</p>
        <p>Цель проекта — сделать французскую кондитерскую школу понятной русскоязычному читателю: систематизировать термины, объяснить технику и физико-химию процессов, отделить документированные факты от легенд и дать ссылки на живые первоисточники.</p>

        <h2>Граница с кондитерской</h2>
        <p>Кондитерская <a href="https://milovicake.ru" target="_blank" rel="noopener noreferrer">Milovi Cake</a> в Санкт-Петербурге — отдельный проект, поддерживающий библиотеку. Она не является автором, редактором или рецензентом учебных разборов французских рецептур, опубликованных здесь. Эти материалы созданы редакцией образовательного проекта и <strong>не входят в коммерческое меню кондитерской</strong>; заказ тортов и десертов возможен только через основной сайт Milovi Cake.</p>

        <h2>Юридическая и этическая позиция</h2>
        <p>Имена шефов, домов, школ и десертов используются для образовательного описания и атрибуции источников. Проект не заявляет партнёрство с этими брендами, если оно явно не указано. Генеративные редакционные иллюстрации помечены видимой подписью и не являются историческими свидетельствами. При обнаружении неточности или спорного фрагмента можно написать через страницу <a href="/corrections/">«Исправления»</a>.</p>
      </section>
    </article>
    </div>
  </StaticPageShell>
</BaseLayout>
