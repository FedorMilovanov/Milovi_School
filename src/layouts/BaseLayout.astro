---
import '../styles/global.css'
import PolicyFooter from '../components/PolicyFooter.astro'
import AnalyticsConsent from '../components/AnalyticsConsent.astro'

interface Props {
  title?: string
  description?: string
  image?: string
  canonicalUrl?: string
  /** 404 and other error documents must not claim a canonical URL. */
  noCanonical?: boolean
  /** Robots meta. 404 and other utility pages can pass 'noindex, follow'. */
  robots?: string
  /** Pages with their own complete footer can suppress the shared policy footer. */
  hidePolicyFooter?: boolean
  /** 'website' for home, 'article' for article pages */
  ogType?: 'website' | 'article'
  /** Explicit OG image dimensions — only pass when the exact size is known */
  ogImageWidth?: number
  ogImageHeight?: number
  /** Article-specific OG properties */
  articlePublishedTime?: string
  articleModifiedTime?: string
  articleAuthor?: string
  articleSection?: string
  articleTags?: string[]
}

const siteUrl = 'https://french.milovicake.ru'
const {
  title = 'Patisserie Russe — Французская кондитерская школа',
  description = 'Библиотека материалов о французской кондитерской школе. Гроле, Эрме, Мишалак, Метайе, Куврер — техники, разборы, рецепты.',
  image = '/images/premium-hero.jpg',
  canonicalUrl = new URL(Astro.url.pathname, siteUrl).href,
  noCanonical = false,
  robots = 'index, follow',
  hidePolicyFooter = false,
  ogType = 'website',
  ogImageWidth,
  ogImageHeight,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
  articleTags,
} = Astro.props

const googleVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '').trim()
const yandexVerification = (import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION ?? '').trim()
const bingVerification = (import.meta.env.PUBLIC_BING_SITE_VERIFICATION ?? '').trim()

// Normalise image: plain string, Vite-resolved path string, or Astro ImageMetadata
const rawImage: string =
  typeof image === 'string'
    ? image
    : typeof image === 'object' && image !== null && 'src' in image
      ? (image as { src: string }).src
      : '/images/premium-hero.jpg'

const ogImage = rawImage.startsWith('http') ? rawImage : `${siteUrl}${rawImage}`

// Trim description to 160 chars for Google snippet (no mid-word truncation)
const lastSpace = description.lastIndexOf(' ', 157)
const metaDescription =
  description.length > 160
    ? description.slice(0, lastSpace > 0 ? lastSpace : 157) + '…'
    : description
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {!noCanonical && <link rel="canonical" href={canonicalUrl} />}
    {articleAuthor && <meta name="author" content={articleAuthor} />}

    <!-- Search-engine ownership. Values are optional repository variables at build time. -->
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <!-- Language targeting -->
    {!noCanonical && <link rel="alternate" hreflang="ru" href={canonicalUrl} />}
    {!noCanonical && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {!noCanonical && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="Patisserie Russe" />
    <meta property="og:locale" content="ru_RU" />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && (articleModifiedTime ?? articlePublishedTime) && (
      <meta
        property="article:modified_time"
        content={articleModifiedTime ?? articlePublishedTime}
      />
    )}
    {ogType === 'article' && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {ogType === 'article' && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}
    {ogType === 'article' && articleTags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Robots -->
    <meta name="robots" content={robots} />

    <meta id="theme-color-meta" name="theme-color" content="#10100f" />

    <!-- Favicons -->
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
    />

    <!-- Apply theme before first paint. -->
    <script is:inline>
      (function () {
        var THEME_LIGHT = '#f5efe5'
        var THEME_DARK = '#10100f'
        var theme = 'dark'
        try {
          var s = localStorage.getItem('theme')
          if (s === 'light' || s === 'dark') {
            theme = s
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light'
          }
        } catch (_) {
          try {
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) theme = 'light'
          } catch (__) {}
        }
        var root = document.documentElement
        try {
          if (localStorage.getItem('pref-large-text') === 'true') root.classList.add('pref-large-text')
          if (localStorage.getItem('pref-focus-mode') === 'true') root.classList.add('focus-mode-active')
        } catch (_) {}
        if (theme === 'dark') {
          root.classList.add('dark')
          root.style.colorScheme = 'dark'
        } else {
          root.style.colorScheme = 'light'
        }
        var meta = document.getElementById('theme-color-meta')
        if (meta) meta.setAttribute('content', theme === 'dark' ? THEME_DARK : THEME_LIGHT)
      })()
    </script>

    <!-- Page-specific head content (JSON-LD, extra meta, etc.) -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Перейти к содержимому</a>

    <slot />
    {!hidePolicyFooter && <PolicyFooter />}
    <AnalyticsConsent />

    <!-- Service worker is skipped in local development. -->
    <script>
      if ('serviceWorker' in navigator) {
        var host = location.hostname
        var isDev = host === 'localhost' || host === '127.0.0.1' || host === '0.0.0.0'
        if (!isDev) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch((err) => { console.warn('[service-worker] registration failed', err) })
          })
        }
      }
    </script>
  </body>
</html>
